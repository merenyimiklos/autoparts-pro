generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { CUSTOMER WAREHOUSE SUPPORT ADMIN SUPERADMIN }
enum ProductStatus { DRAFT ACTIVE INACTIVE ARCHIVED }
enum FuelType { PETROL DIESEL HYBRID PHEV ELECTRIC LPG OTHER }
enum OrderStatus { DRAFT AWAITING_PAYMENT PAID PROCESSING AWAITING_STOCK PICKING PACKED HANDED_TO_COURIER READY_FOR_PICKUP COMPLETED CANCELLED RETURN_IN_PROGRESS PARTIALLY_REFUNDED REFUNDED }
enum PaymentStatus { PENDING AUTHORIZED PAID FAILED REFUNDED PARTIAL_REFUND }
enum ShippingStatus { PENDING PREPARING SHIPPED READY DELIVERED RETURNED }
enum InventoryMovementType { RECEIPT SALE RESERVATION RELEASE RETURN SCRAP ADJUSTMENT TRANSFER_IN TRANSFER_OUT }
enum PromotionType { PERCENT FIXED FREE_SHIPPING }
enum PromotionScope { PRODUCT CATEGORY MANUFACTURER CART }
enum ReturnStatus { REQUESTED APPROVED REJECTED RECEIVED REFUNDED }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  role Role @default(CUSTOMER)
  emailVerifiedAt DateTime?
  refreshTokenHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addresses Address[]
  garage GarageVehicle[]
  carts Cart[]
  orders Order[]
  reviews Review[]
  returns ReturnRequest[]
  inventoryMovements InventoryMovement[] @relation("InventoryActor")
  statusChanges OrderStatusHistory[] @relation("StatusActor")
  auditLogs AuditLog[] @relation("AuditActor")
}

model Address {
  id String @id @default(cuid())
  userId String
  label String
  recipient String
  postalCode String
  city String
  street String
  country String @default("HU")
  phone String?
  isBilling Boolean @default(false)
  isDefault Boolean @default(false)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}

model VehicleBrand { id String @id @default(cuid()) name String @unique models VehicleModel[] }
model VehicleModel { id String @id @default(cuid()) brandId String name String brand VehicleBrand @relation(fields:[brandId],references:[id],onDelete:Cascade) generations VehicleGeneration[] @@unique([brandId,name]) }
model VehicleGeneration { id String @id @default(cuid()) modelId String name String yearFrom Int yearTo Int? bodyStyle String model VehicleModel @relation(fields:[modelId],references:[id],onDelete:Cascade) engines VehicleEngine[] @@unique([modelId,name,yearFrom]) }
model VehicleEngine {
  id String @id @default(cuid())
  generationId String
  name String
  engineCode String?
  fuel FuelType
  powerKw Int?
  displacementCc Int?
  drivetrain String?
  transmission String?
  generation VehicleGeneration @relation(fields:[generationId],references:[id],onDelete:Cascade)
  fitments ProductFitment[]
  garage GarageVehicle[]
  @@unique([generationId,name])
}
model GarageVehicle { id String @id @default(cuid()) userId String engineId String label String? vin String? isDefault Boolean @default(false) user User @relation(fields:[userId],references:[id],onDelete:Cascade) engine VehicleEngine @relation(fields:[engineId],references:[id]) @@unique([userId,engineId]) }

model Manufacturer { id String @id @default(cuid()) name String @unique products Product[] }
model Category { id String @id @default(cuid()) parentId String? name String slug String @unique parent Category? @relation("CategoryTree",fields:[parentId],references:[id]) children Category[] @relation("CategoryTree") products Product[] }
model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  sku String @unique
  ean String?
  shortDescription String
  description String
  manufacturerId String
  netPrice Decimal @db.Decimal(12,2)
  grossPrice Decimal @db.Decimal(12,2)
  vatRate Decimal @db.Decimal(5,2)
  purchasePrice Decimal? @db.Decimal(12,2)
  weightGrams Int?
  warrantyMonths Int? @default(24)
  status ProductStatus @default(DRAFT)
  seoTitle String?
  seoDescription String?
  minStock Int @default(2)
  universal Boolean @default(false)
  specs Json?
  oemNumbers String[]
  alternativeNumbers String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  manufacturer Manufacturer @relation(fields:[manufacturerId],references:[id])
  categories Category[]
  images ProductImage[]
  variants ProductVariant[]
  fitments ProductFitment[]
  inventory InventoryBalance[]
  cartItems CartItem[]
  orderItems OrderItem[]
  reviews Review[]
  inventoryMovements InventoryMovement[]
  promotionProducts PromotionProduct[]
  relatedFrom ProductRelation[] @relation("RelatedFrom")
  relatedTo ProductRelation[] @relation("RelatedTo")
}
model ProductImage { id String @id @default(cuid()) productId String url String alt String? sortOrder Int @default(0) isPrimary Boolean @default(false) product Product @relation(fields:[productId],references:[id],onDelete:Cascade) }
model ProductVariant { id String @id @default(cuid()) productId String sku String @unique ean String? name String specs Json? grossPrice Decimal? @db.Decimal(12,2) active Boolean @default(true) product Product @relation(fields:[productId],references:[id],onDelete:Cascade) }
model ProductFitment { id String @id @default(cuid()) productId String engineId String notes String? exclusions String? product Product @relation(fields:[productId],references:[id],onDelete:Cascade) engine VehicleEngine @relation(fields:[engineId],references:[id],onDelete:Cascade) @@unique([productId,engineId]) }
model ProductRelation { id String @id @default(cuid()) fromProductId String toProductId String kind String fromProduct Product @relation("RelatedFrom",fields:[fromProductId],references:[id],onDelete:Cascade) toProduct Product @relation("RelatedTo",fields:[toProductId],references:[id],onDelete:Cascade) @@unique([fromProductId,toProductId,kind]) }

model Warehouse { id String @id @default(cuid()) code String @unique name String address String active Boolean @default(true) inventory InventoryBalance[] movements InventoryMovement[] }
model InventoryBalance {
  id String @id @default(cuid())
  productId String
  warehouseId String
  physical Int @default(0)
  reserved Int @default(0)
  damaged Int @default(0)
  incoming Int @default(0)
  product Product @relation(fields:[productId],references:[id])
  warehouse Warehouse @relation(fields:[warehouseId],references:[id])
  @@unique([productId,warehouseId])
}
model InventoryMovement {
  id String @id @default(cuid())
  productId String
  warehouseId String
  type InventoryMovementType
  quantity Int
  previousPhysical Int
  newPhysical Int
  previousReserved Int
  newReserved Int
  orderId String?
  actorId String?
  reason String?
  note String?
  createdAt DateTime @default(now())
  warehouse Warehouse @relation(fields:[warehouseId],references:[id])
  product Product @relation(fields:[productId],references:[id])
  actor User? @relation("InventoryActor",fields:[actorId],references:[id])
  @@index([productId,warehouseId,createdAt])
}

model Cart { id String @id @default(cuid()) userId String? sessionKey String? couponCode String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User? @relation(fields:[userId],references:[id],onDelete:Cascade) items CartItem[] @@index([sessionKey]) }
model CartItem { id String @id @default(cuid()) cartId String productId String quantity Int cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade) product Product @relation(fields:[productId],references:[id]) @@unique([cartId,productId]) }

model Promotion { id String @id @default(cuid()) name String type PromotionType scope PromotionScope value Decimal @db.Decimal(12,2) priority Int @default(0) startsAt DateTime endsAt DateTime? active Boolean @default(true) products PromotionProduct[] coupons Coupon[] }
model PromotionProduct { promotionId String productId String promotion Promotion @relation(fields:[promotionId],references:[id],onDelete:Cascade) product Product @relation(fields:[productId],references:[id],onDelete:Cascade) @@id([promotionId,productId]) }
model Coupon { id String @id @default(cuid()) code String @unique promotionId String minCartGross Decimal? @db.Decimal(12,2) globalLimit Int? perUserLimit Int? usedCount Int @default(0) promotion Promotion @relation(fields:[promotionId],references:[id],onDelete:Cascade) usages CouponUsage[] }
model CouponUsage { id String @id @default(cuid()) couponId String userId String? orderId String createdAt DateTime @default(now()) coupon Coupon @relation(fields:[couponId],references:[id],onDelete:Cascade) @@index([couponId,userId]) @@unique([couponId,orderId]) }

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  userId String?
  email String
  status OrderStatus @default(AWAITING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  shippingStatus ShippingStatus @default(PENDING)
  subtotalGross Decimal @db.Decimal(12,2)
  discountGross Decimal @default(0) @db.Decimal(12,2)
  shippingGross Decimal @default(0) @db.Decimal(12,2)
  totalGross Decimal @db.Decimal(12,2)
  currency String @default("HUF")
  paymentMethod String
  shippingMethod String
  shippingAddress Json
  billingAddress Json
  trackingNumber String?
  internalNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields:[userId],references:[id])
  items OrderItem[]
  history OrderStatusHistory[]
  returns ReturnRequest[]
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String?
  sku String
  productName String
  quantity Int
  unitNet Decimal @db.Decimal(12,2)
  vatRate Decimal @db.Decimal(5,2)
  unitGross Decimal @db.Decimal(12,2)
  discountGross Decimal @default(0) @db.Decimal(12,2)
  lineGross Decimal @db.Decimal(12,2)
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
}
model OrderStatusHistory { id String @id @default(cuid()) orderId String fromStatus OrderStatus? toStatus OrderStatus actorId String? customerNote String? internalNote String? createdAt DateTime @default(now()) order Order @relation(fields:[orderId],references:[id],onDelete:Cascade) actor User? @relation("StatusActor",fields:[actorId],references:[id]) }
model Review { id String @id @default(cuid()) userId String productId String rating Int title String? body String? approved Boolean @default(false) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) product Product @relation(fields:[productId],references:[id]) @@unique([userId,productId]) }
model ReturnRequest { id String @id @default(cuid()) orderId String userId String status ReturnStatus @default(REQUESTED) reason String note String? createdAt DateTime @default(now()) order Order @relation(fields:[orderId],references:[id]) user User @relation(fields:[userId],references:[id]) }
model AuditLog { id String @id @default(cuid()) actorId String? action String entityType String entityId String? before Json? after Json? ip String? createdAt DateTime @default(now()) actor User? @relation("AuditActor",fields:[actorId],references:[id]) @@index([entityType,entityId,createdAt]) }

model AuthToken { id String @id @default(cuid()) userId String type String tokenHash String @unique expiresAt DateTime usedAt DateTime? createdAt DateTime @default(now()) @@index([userId,type]) }
model PaymentEvent { id String @id @default(cuid()) provider String providerEventId String @unique orderId String payload Json createdAt DateTime @default(now()) @@index([orderId,createdAt]) }
