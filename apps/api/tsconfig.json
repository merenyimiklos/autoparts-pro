{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "outDir": "./dist", "rootDir": ".",
    "strict": true, "noImplicitOverride": true, "esModuleInterop": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts"]
}
